<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visa Requirements - VisaTrack Admin</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      nav {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 1rem;
        margin-bottom: 2rem;
        border-radius: 10px;
      }
      nav ul {
        list-style: none;
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
      }
      nav a {
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      nav a i {
        font-size: 1.1em;
      }
      nav a:hover {
        opacity: 0.8;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
      }
      h1 {
        color: white;
        font-size: 2.5rem;
      }
      .admin-info {
        color: white;
        font-size: 14px;
      }
      .card {
        background: white;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #eee;
      }
      th {
        background: #f8f9fa;
        font-weight: 600;
        color: #333;
      }
      tr:hover {
        background: #f8f9fa;
      }
      .btn {
        display: inline-block;
        padding: 8px 16px;
        margin-right: 8px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
      }
      .btn-primary {
        background: #667eea;
        color: white;
      }
      .btn-primary:hover {
        background: #5568d3;
      }
      .btn-danger {
        background: #ff6b6b;
        color: white;
      }
      .btn-danger:hover {
        background: #ee5a52;
      }
      .btn-success {
        background: #51cf66;
        color: white;
      }
      .btn-success:hover {
        background: #40c057;
      }
      .upload-section {
        margin-bottom: 30px;
      }
      input[type="file"] {
        margin-right: 10px;
      }
      .no-data {
        text-align: center;
        padding: 40px;
        color: #999;
      }
      footer {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        text-align: center;
        padding: 20px;
        border-radius: 10px;
        margin-top: 40px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav>
        <ul>
          <li><a href="/admin/dashboard">Dashboard</a></li>
          <li><a href="/admin/visas">Manage Visas</a></li>
          <li><a href="/admin/visas/new">Add Visa</a></li>
          <li><a href="/logout">Logout</a></li>
        </ul>
      </nav>

      <div class="header">
        <h1>Visa Requirements</h1>
        <div class="admin-info">
          Welcome, <strong><%= adminName || 'Admin' %></strong>
        </div>
      </div>

      <% if (success) { %>
      <div
        style="
          background: #d4edda;
          border: 1px solid #c3e6cb;
          color: #155724;
          padding: 15px;
          border-radius: 5px;
          margin-bottom: 20px;
          display: flex;
          align-items: center;
          gap: 10px;
        "
      >
        <span style="font-size: 20px">✓</span>
        <div><strong>Success!</strong> <%= success %></div>
      </div>
      <% } %> <% if (error) { %>
      <div
        style="
          background: #f8d7da;
          border: 1px solid #f5c6cb;
          color: #721c24;
          padding: 15px;
          border-radius: 5px;
          margin-bottom: 20px;
          display: flex;
          align-items: center;
          gap: 10px;
        "
      >
        <span style="font-size: 20px">✕</span>
        <div><strong>Error:</strong> <%= error %></div>
      </div>
      <% } %> <% if (uploadErrors && uploadErrors.length > 0) { %>
      <div
        style="
          background: #fff3cd;
          border: 1px solid #ffeeba;
          color: #856404;
          padding: 15px;
          border-radius: 5px;
          margin-bottom: 20px;
        "
      >
        <strong>Upload Warnings:</strong>
        <ul style="margin-top: 10px; padding-left: 20px">
          <% uploadErrors.forEach(err => { %>
          <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <div class="card upload-section">
        <h2><i class="fas fa-file-csv"></i> Upload Visa Data</h2>
        <form
          action="/admin/visas/upload"
          method="POST"
          enctype="multipart/form-data"
          style="margin-top: 15px"
        >
          <input type="file" name="file" accept=".csv,.json" required />
          <button type="submit" class="btn btn-success">Upload CSV/JSON</button>
        </form>
        <p style="margin-top: 10px; font-size: 12px; color: #666">
          Supported formats: CSV (country, visaType, requirements,
          processingTime, fees) and JSON
        </p>
      </div>

      <div class="card">
        <div style="margin-bottom: 20px">
          <a href="/admin/visas/new" class="btn btn-primary"
            >+ Add New Visa Requirement</a
          >
        </div>

        <% if (visas && visas.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Country</th>
              <th>Visa Type</th>
              <th>Requirements</th>
              <th>Processing Time</th>
              <th>Fees</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% visas.forEach(visa => { %>
            <tr>
              <td><%= visa.country %></td>
              <td><%= visa.visaType || visa.type %></td>
              <td>
                <%= Array.isArray(visa.requirements) ? visa.requirements.join(',
                ') : visa.requirements %>
              </td>
              <td><%= visa.processingTime %></td>
              <td>$<%= visa.fees %></td>
              <td>
                <a
                  href="/admin/visas/<%= visa._id %>/edit"
                  class="btn btn-primary"
                  >Edit</a
                >
                <form
                  action="/admin/visas/<%= visa._id %>"
                  method="POST"
                  style="display: inline"
                  onsubmit="return confirm('Delete this visa requirement?');"
                >
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <div class="no-data">
          No visa requirements found.
          <a href="/admin/visas/new" style="color: #667eea">Add one now</a>
        </div>
        <% } %>
      </div>

      <footer>
        <p>
          &copy; <%= new Date().getFullYear() %> VisaTrack Admin Panel. All
          rights reserved.
        </p>
      </footer>
    </div>
  </body>
</html>
